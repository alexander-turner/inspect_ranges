{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EbsFsrSpike",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVolume",
        "ec2:DeleteVolume",
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:CreateSnapshot",
        "ec2:DeleteSnapshot",
        "ec2:CreateTags",
        "ec2:DescribeVolumes",
        "ec2:DescribeSnapshots",
        "ec2:EnableFastSnapshotRestores",
        "ec2:DisableFastSnapshotRestores",
        "ec2:DescribeFastSnapshotRestores"
      ],
      "Resource": "*"
    }
  ]
}
