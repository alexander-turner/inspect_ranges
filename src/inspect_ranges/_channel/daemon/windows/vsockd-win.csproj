<Project Sdk="Microsoft.NET.Sdk">
  <!-- Host-side build of the vector check only (Wire.cs + VectorCheck.cs).
       The daemon itself (Daemon.cs, Program.cs) compiles IN-GUEST with the
       in-box .NET Framework 4.8 csc.exe; LangVersion 5 keeps every file
       within that compiler's reach. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>5</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>VectorCheck</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Wire.cs" />
    <Compile Include="VectorCheck.cs" />
  </ItemGroup>
</Project>
